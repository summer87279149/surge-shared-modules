#!name=金融服务 · 美国（GitHub 版）
#!desc=指定金融服务走 US。Bybit 固定走土耳其节点，OKX 的其他入口和相关服务走 Proxies。
#!version=1.1.0
#!system=ios

[Rule]
RULE-SET,Bybit,"🇹🇷 土耳其标准 IEPL 专线 1",extended-matching
RULE-SET,Finance-US,US
RULE-SET,OKX,Proxies

[Ruleset Finance-US]
# 支付与跨境收款
DOMAIN-SUFFIX,paypal.com
